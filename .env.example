# OpenServ API key for SERV Reasoning (from your OpenServ account dashboard).
# Without it, the SERV client runs in mock mode so tests/demo work offline.
OPENSERV_API_KEY=

# Optional: override the SERV API origin (used by the stub-server test).
# SERV_BASE_URL=https://inference-api.openserv.ai/v1

# Adapter mode: mock | sandbox | live
KITEGUARD_MODE=mock

# Policy defaults (USD). The owner can tighten these per request.
KITEGUARD_MAX_PER_TX=1
KITEGUARD_MAX_TOTAL=5
